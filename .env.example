# Standalone only. Copy to ui/.env.local and use a 64-character lowercase
# hexadecimal token matching the n8n X-Multi-Agent-Key Header Auth credential.
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
OPENAI_MODEL=gpt-5-mini
N8N_WEBHOOK_SECRET=
# Optional absolute path. Default is ~/.ortak-akil/evaluations.sqlite.
# HISTORY_DB_PATH=
GOOGLE_DOCS_ENABLED=false
